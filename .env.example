# VeriTrace Environment Configuration

# Database: PostgreSQL 16 (or leave empty / use sqlite:///./veritrace.db for local dev fallback)
DATABASE_URL=sqlite:///./veritrace.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veritrace

# Security & Auth
SECRET_KEY=veritrace-super-secret-key-change-in-production-2026-sih
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
UPLOAD_DIR=./uploads
STORAGE_DIR=./storage

# Rule Engine Settings
LOW_CONFIDENCE_THRESHOLD=0.65
FUZZY_MATCH_THRESHOLD=85.0

# CORS & Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional LLM polish / re-read (Quote-or-reject guard)
# GEMINI_API_KEY=your_gemini_api_key_here
